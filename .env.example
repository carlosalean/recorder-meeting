# Copia este archivo como .env y rellena los valores.

# Clave de la API de Anthropic (la misma que usa la grabadora).
ANTHROPIC_API_KEY=sk-ant-...
# Solo si tu clave no está asociada a un workspace:
ANTHROPIC_WORKSPACE_ID=
# Modelo de Claude que analiza las reuniones.
ANTHROPIC_MODEL=claude-opus-5

# Quién graba las reuniones (tú). Ayuda a la IA a situarte en las conversaciones.
OWNER_NAME=
OWNER_ROLE=Desarrollador y arquitecto de software que trabaja para varias empresas

# Carpeta donde la grabadora guarda las reuniones (en Windows usa barras /).
REUNIONES_DIR=C:/Users/carlo/Reuniones

# Zona horaria para mostrar fechas y horas.
TZ=Europe/Madrid

# Opcionales
POSTGRES_PASSWORD=meetings
WEB_PORT=3000
DB_PORT=5433
